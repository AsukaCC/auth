# 复制为 .env 后填写配置，Go 服务启动时自动读取；进程环境变量优先。
AUTH_ADDR=127.0.0.1:8080
AUTH_DATA_DIR=./data
AUTH_WEB_DIR=./web/dist
AUTH_PUBLIC_URL=http://127.0.0.1:5173
# HTTPS 部署时设为 true
AUTH_SECURE_COOKIE=false

# 仅首次启动且用户表为空时初始化；已有账户不会被覆盖。
# 必须填写有效邮箱和 10–72 字节的密码。密码建议使用单引号包裹。
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_NAME=管理员
AUTH_ADMIN_PASSWORD=''
