# 首次部署前复制为 .env 并填写管理员配置，由 Docker Compose 读取。
# 本机或宿主机上的反向代理访问，默认仅监听回环地址。
AUTH_BIND_ADDRESS=127.0.0.1
AUTH_PORT=8080

# 必须与浏览器实际访问地址一致，用于来源校验和密码找回链接。
# 修改端口时也要同步修改这里；HTTPS 示例：https://auth.example.com
AUTH_PUBLIC_URL=http://127.0.0.1:8080

# 通过 HTTPS 访问时设置为 true；本地 HTTP 使用 false。
AUTH_SECURE_COOKIE=false

# 仅在用户表为空时初始化管理员；不会重置已有账户。
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_NAME=管理员
# 必填：10–72 字节。单引号可保留密码中的 $ 和 # 等字符。
AUTH_ADMIN_PASSWORD=''
